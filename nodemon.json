{
  "watch": [
    "app.ts",
    "Community_AI",
    "Config",
    "Controller",
    "Cron",
    "DB",
    "Socket",
    "docs",
    "middleware",
    "models",
    "router",
    "types",
    "utils"
  ],
  "ext": "ts,json",
  "ignore": [
    "dist",
    "node_modules",
    "tests"
  ],
  "exec": "tsx app.ts",
  "signal": "SIGTERM",
  "delay": "500"
}
