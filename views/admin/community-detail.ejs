<%- include("partials/shell-top", {
  title,
  csrfToken,
  permissions,
  activeTab,
  sectionLabel: "Community record",
  heading: community.name,
  subtitle: "Profile, rules, access settings, membership, join requests, payments, and activity.",
  message,
}) %>

<div class="back-link"><a href="/admin/communities">← All communities</a><span class="status <%= community.isActive === false ? 'status-deactivated' : 'status-active' %>"><%= community.isActive === false ? "deactivated" : "active" %></span></div>

<section class="community-hero panel">
  <div class="community-art"><% if (community.coverImageUrl || community.imageUrl || community.avatarImageUrl) { %><img src="<%= community.coverImageUrl || community.imageUrl || community.avatarImageUrl %>" alt="<%= community.name %> cover"><% } else { %><span><%= community.name.charAt(0).toUpperCase() %></span><% } %></div>
  <div class="community-hero-copy">
    <p class="eyebrow"><%= community.category %> · <%= community.visibility %></p><h2><%= community.name %></h2><p><%= community.description %></p>
    <div class="tag-list"><span class="role-tag"><%= community.membershipType %> membership</span><span class="role-tag"><%= community.joinPolicy.replaceAll("_", " ") %></span><% if (community.state) { %><span class="role-tag"><%= community.lga ? community.lga + ", " : "" %><%= community.state %></span><% } %><% if (community.avatarImageUrl) { %><span class="role-tag">Custom avatar</span><% } %></div>
    <p class="community-owner"><strong>Owner</strong> · <%= community.ownerId?.firstName || "Unknown" %> <%= community.ownerId?.lastName || "" %><small><%= community.ownerId?.email || "" %></small></p>
  </div>
  <div class="community-action-card">
    <% if (community.isActive === false) { %><p>This community is deactivated and hidden from discovery. Protected member features and community chat access are disabled.</p><form method="post" action="/admin/communities/<%= community._id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="isActive" value="true"><button class="button button-primary" type="submit">Activate community</button></form>
    <% } else { %><p>Deactivation removes this community from discovery and disables protected member features.</p><form method="post" action="/admin/communities/<%= community._id %>/status" class="deactivate-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="isActive" value="false"><label>Reason for deactivation<input name="reason" required minlength="5" maxlength="300" placeholder="Explain the moderation decision"></label><button class="button button-danger" type="submit">Deactivate community</button></form><% } %>
  </div>
</section>

<% if (community.isActive === false && community.adminDeactivationReason) { %><div class="alert alert-error community-audit"><strong>Deactivation reason</strong> · <%= community.adminDeactivationReason %><small>Recorded <%= community.adminDeactivatedAt ? new Date(community.adminDeactivatedAt).toLocaleString("en-NG") : "" %><% if (community.adminDeactivatedBy) { %> by <%= community.adminDeactivatedBy.firstName %> <%= community.adminDeactivatedBy.lastName %><% } %></small></div><% } %>
<% if (community.adminActivatedAt) { %><div class="community-activation-note">Last activated <%= new Date(community.adminActivatedAt).toLocaleString("en-NG") %><% if (community.adminActivatedBy) { %> by <%= community.adminActivatedBy.firstName %> <%= community.adminActivatedBy.lastName %><% } %></div><% } %>

<section class="stats-grid stats-grid-compact" aria-label="Community totals">
  <article class="stat-card"><span>All members</span><strong><%= memberCount.toLocaleString("en-NG") %></strong><small><%= memberStats.active || 0 %> active · <%= memberStats.pending || 0 %> pending</small></article>
  <article class="stat-card"><span>Membership orders</span><strong><%= orderCount.toLocaleString("en-NG") %></strong><small><%= paidOrderCount.toLocaleString("en-NG") %> paid · <%= orderStatusCounts.refunded || 0 %> refunded</small></article>
  <article class="stat-card"><span>Join requests</span><strong><%= joinRequestCounts.pending || 0 %></strong><small><%= joinRequestCounts.approved || 0 %> approved · <%= joinRequestCounts.rejected || 0 %> rejected</small></article>
  <article class="stat-card stat-accent"><span>Community activity</span><strong><%= contentCount.toLocaleString("en-NG") %></strong><small>Posts, announcements, and messages</small></article>
</section>

<div class="detail-grid">
  <section class="panel detail-panel">
    <div class="panel-heading"><div><p class="eyebrow">Community configuration</p><h2>Access and settings</h2></div></div>
    <dl class="detail-list">
      <div><dt>Community ID</dt><dd><%= community._id %></dd></div>
      <div><dt>Slug</dt><dd><%= community.slug %></dd></div>
      <div><dt>Visibility and join policy</dt><dd><%= community.visibility %><small><%= community.joinPolicy.replaceAll("_", " ") %></small></dd></div>
      <div><dt>Membership</dt><dd><%= community.membershipType %><small><%= community.membershipType === "premium" ? formatNaira(community.membershipPriceKobo) : "Free to join" %></small></dd></div>
      <div><dt>Who can message</dt><dd><%= community.messagePermission || "everyone" %></dd></div>
      <div><dt>Member permissions</dt><dd>Posts: <%= community.membersCanCreatePosts ? "allowed" : "disabled" %><small>Invites: <%= community.membersCanInvite ? "allowed" : "disabled" %> · Member list: <%= community.showMemberList ? "visible" : "hidden" %></small></dd></div>
      <div><dt>Access code</dt><dd><%= community.joinPolicy === "access_code" ? "Protected code is configured" : "Not required" %></dd></div>
      <div><dt>Created</dt><dd><%= new Date(community.createdAt).toLocaleString("en-NG") %><small>Updated <%= new Date(community.updatedAt).toLocaleString("en-NG") %></small></dd></div>
      <div><dt>Last activity</dt><dd><%= community.lastActivityAt ? new Date(community.lastActivityAt).toLocaleString("en-NG") : "No activity recorded" %></dd></div>
    </dl>
  </section>

  <section class="panel community-rules-panel">
    <div class="panel-heading"><div><p class="eyebrow">Member guidance</p><h2>Rules and consequences</h2><p>Current rules shown to people in this community.</p></div><span class="count-pill"><%= (community.rules || []).length %> rules</span></div>
    <% if (community.rulesIntroduction) { %><p class="community-rules-intro"><%= community.rulesIntroduction %></p><% } %>
    <ol class="community-rules-list"><% (community.rules || []).forEach((rule) => { %><li><strong><%= rule.title %></strong><p><%= rule.description %></p></li><% }) %></ol>
    <% if (!(community.rules || []).length && !community.rulesIntroduction) { %><p class="empty">No community rules have been added.</p><% } %>
    <% if ((community.consequences || []).length) { %><div class="community-consequences"><p class="eyebrow">Possible consequences</p><ul><% community.consequences.forEach((consequence) => { %><li><%= consequence %></li><% }) %></ul></div><% } %>
    <% if (community.rulesUpdatedAt) { %><p class="community-rules-audit">Updated <%= new Date(community.rulesUpdatedAt).toLocaleString("en-NG") %><% if (community.rulesUpdatedBy) { %> by <%= community.rulesUpdatedBy.firstName %> <%= community.rulesUpdatedBy.lastName %><% } %></p><% } %>
  </section>
</div>

<section class="panel community-data-panel">
  <div class="panel-heading"><div><p class="eyebrow">Membership</p><h2>Community members</h2><p>Recent membership records and current access state.</p></div><span class="count-pill"><%= memberCount.toLocaleString("en-NG") %> total</span></div>
  <div class="table-wrap"><table><thead><tr><th>Member</th><th>Role</th><th>Status</th><th>Notifications</th><th>Joined</th></tr></thead><tbody>
    <% members.forEach((member) => { const user = member.userId || {}; %><tr><td><strong><%= user.firstName || "Unavailable" %> <%= user.lastName || "" %></strong><small><%= user.email || "" %> · <%= user.status || "" %></small></td><td><span class="role-tag"><%= member.role %></span></td><td><span class="status status-<%= member.status %>"><%= member.status.replaceAll("_", " ") %></span><% if (member.muted) { %><small>Muted</small><% } %></td><td><%= member.notificationLevel || (member.muted ? "muted" : "all") %></td><td><%= member.joinedAt ? new Date(member.joinedAt).toLocaleString("en-NG") : "—" %></td></tr><% }) %>
    <% if (!members.length) { %><tr><td colspan="5" class="empty">No member records.</td></tr><% } %>
  </tbody></table></div>
  <div class="pagination"><span>Member page <%= memberPage %> of <%= memberPageCount %></span><div><% if (memberPage > 1) { %><a class="button button-soft button-small" href="?memberPage=<%= memberPage - 1 %>&amp;orderPage=<%= orderPage %>&amp;contentPage=<%= contentPage %>">Previous</a><% } %><% if (memberPage < memberPageCount) { %><a class="button button-soft button-small" href="?memberPage=<%= memberPage + 1 %>&amp;orderPage=<%= orderPage %>&amp;contentPage=<%= contentPage %>">Next</a><% } %></div></div>
</section>

<div class="detail-grid">
  <section class="panel community-data-panel">
    <div class="panel-heading"><div><p class="eyebrow">Membership sales</p><h2>All membership orders</h2><p>Payment state, amount, platform fee, and owner proceeds.</p></div><span class="count-pill"><%= orderCount.toLocaleString("en-NG") %> orders</span></div>
    <div class="table-wrap"><table><thead><tr><th>Order</th><th>Member</th><th>Gross paid</th><th>Platform fee</th><th>Owner proceeds</th><th>Status</th></tr></thead><tbody>
      <% orders.forEach((order) => { const buyer = order.buyerId || {}; %><tr><td><strong><%= order.orderNumber %></strong><small><%= new Date(order.createdAt).toLocaleString("en-NG") %></small></td><td><strong><%= buyer.firstName || "Unavailable" %> <%= buyer.lastName || "" %></strong><small><%= buyer.email || "" %></small></td><td><%= formatNaira(order.grossAmountKobo) %></td><td><%= formatNaira(order.platformFeeKobo) %></td><td><%= formatNaira(order.ownerProceedsKobo) %></td><td><span class="status status-<%= order.status %>"><%= order.status %></span><% if (order.paidAt) { %><small><%= new Date(order.paidAt).toLocaleString("en-NG") %></small><% } %></td></tr><% }) %>
      <% if (!orders.length) { %><tr><td colspan="6" class="empty">No membership orders.</td></tr><% } %>
    </tbody></table></div>
    <div class="pagination"><span>Order page <%= orderPage %> of <%= orderPageCount %></span><div><% if (orderPage > 1) { %><a class="button button-soft button-small" href="?memberPage=<%= memberPage %>&amp;orderPage=<%= orderPage - 1 %>&amp;contentPage=<%= contentPage %>">Previous</a><% } %><% if (orderPage < orderPageCount) { %><a class="button button-soft button-small" href="?memberPage=<%= memberPage %>&amp;orderPage=<%= orderPage + 1 %>&amp;contentPage=<%= contentPage %>">Next</a><% } %></div></div>
  </section>

  <section class="panel community-data-panel">
    <div class="panel-heading"><div><p class="eyebrow">Join requests</p><h2>Member requests</h2><p>Recent requests with their review notes and outcomes.</p></div><span class="count-pill"><%= joinRequestCounts.pending || 0 %> pending</span></div>
    <div class="request-list"><% joinRequests.forEach((joinRequest) => { const requester = joinRequest.requesterId || {}; const reviewer = joinRequest.reviewedBy || {}; %><article class="request-item"><div class="request-item-head"><strong><%= requester.firstName || "Unavailable" %> <%= requester.lastName || "" %></strong><span class="status status-<%= joinRequest.status %>"><%= joinRequest.status %></span></div><small><%= requester.email || "" %> · Submitted <%= new Date(joinRequest.createdAt).toLocaleString("en-NG") %></small><% if (joinRequest.message) { %><p><%= joinRequest.message %></p><% } %><% if (joinRequest.reviewNote) { %><p class="request-review-note"><strong>Review note</strong> · <%= joinRequest.reviewNote %><% if (reviewer.firstName) { %><small>By <%= reviewer.firstName %> <%= reviewer.lastName || "" %></small><% } %></p><% } %></article><% }) %><% if (!joinRequests.length) { %><p class="empty">No join requests.</p><% } %></div>
  </section>
</div>

<section class="panel community-data-panel">
  <div class="panel-heading"><div><p class="eyebrow">Community activity</p><h2>Posts, announcements, and messages</h2><p>Recent content includes text, shared images, and uploaded files.</p></div><span class="count-pill"><%= contentCount.toLocaleString("en-NG") %> records</span></div>
  <div class="activity-list"><% content.forEach((item) => { const author = item.authorId || {}; %><article class="activity-item"><div class="activity-topline"><span class="role-tag"><%= item.kind %></span><span><%= new Date(item.createdAt).toLocaleString("en-NG") %></span><% if (item.pinnedAt) { %><span class="status status-active">pinned</span><% } %><% if (item.deletedAt) { %><span class="status status-deactivated">removed</span><% } %><% if (item.editedAt) { %><span class="muted">edited <%= new Date(item.editedAt).toLocaleString("en-NG") %></span><% } %></div><p><%= item.text || "Shared an attachment" %></p><% if (item.imageUrl) { %><a class="community-attachment-preview" href="<%= item.imageUrl %>" target="_blank" rel="noopener noreferrer"><img src="<%= item.imageUrl %>" alt="Community content attachment" loading="lazy"></a><% } %><% (item.attachments || []).forEach((attachment) => { %><a class="attachment-link" href="<%= attachment.url %>" target="_blank" rel="noopener noreferrer"><%= attachment.name %> · <%= attachment.type %> · <%= (attachment.sizeBytes / 1024).toFixed(0) %> KB ↗</a><% }) %><small>By <%= author.firstName || "Unknown" %> <%= author.lastName || "" %><% if (item.replyToId) { %> · Reply to another community item<% } %></small></article><% }) %><% if (!content.length) { %><p class="empty">No community content yet.</p><% } %></div>
  <div class="pagination"><span>Activity page <%= contentPage %> of <%= contentPageCount %></span><div><% if (contentPage > 1) { %><a class="button button-soft button-small" href="?memberPage=<%= memberPage %>&amp;orderPage=<%= orderPage %>&amp;contentPage=<%= contentPage - 1 %>">Previous</a><% } %><% if (contentPage < contentPageCount) { %><a class="button button-soft button-small" href="?memberPage=<%= memberPage %>&amp;orderPage=<%= orderPage %>&amp;contentPage=<%= contentPage + 1 %>">Next</a><% } %></div></div>
</section>
<%- include("partials/shell-bottom") %>
