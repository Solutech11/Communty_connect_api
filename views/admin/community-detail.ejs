<%- include("partials/shell-top", {
  title,
  csrfToken,
  permissions,
  activeTab,
  sectionLabel: "Community record",
  heading: community.name,
  subtitle: "Community profile, access, membership, activity, and membership payments.",
  message,
}) %>

<div class="back-link"><a href="/admin/communities">← All communities</a><span class="status <%= community.isActive === false ? 'status-deactivated' : 'status-active' %>"><%= community.isActive === false ? "deactivated" : "active" %></span></div>
<section class="community-hero panel">
  <div class="community-art"><% if (community.coverImageUrl || community.imageUrl) { %><img src="<%= community.coverImageUrl || community.imageUrl %>" alt="<%= community.name %> cover"><% } else { %><span><%= community.name.charAt(0).toUpperCase() %></span><% } %></div>
  <div class="community-hero-copy"><p class="eyebrow"><%= community.category %> · <%= community.visibility %></p><h2><%= community.name %></h2><p><%= community.description %></p><div class="tag-list"><span class="role-tag"><%= community.membershipType %> membership</span><span class="role-tag"><%= community.joinPolicy.replaceAll("_", " ") %></span><% if (community.state) { %><span class="role-tag"><%= community.lga ? community.lga + ", " : "" %><%= community.state %></span><% } %></div><p class="community-owner"><strong>Owner</strong> · <%= community.ownerId?.firstName || "Unknown" %> <%= community.ownerId?.lastName || "" %><small><%= community.ownerId?.email || "" %></small></p></div>
  <div class="community-action-card"><% if (community.isActive === false) { %><p>This community is deactivated and hidden from active discovery. Members cannot use its protected community features.</p><form method="post" action="/admin/communities/<%= community._id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="isActive" value="true"><button class="button button-primary" type="submit">Activate community</button></form><% } else { %><p>Deactivate the community if it breaches platform rules. This blocks discovery and protected member features.</p><form method="post" action="/admin/communities/<%= community._id %>/status" class="deactivate-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="isActive" value="false"><label>Reason for deactivation<input name="reason" required minlength="5" maxlength="300" placeholder="Explain the moderation decision"></label><button class="button button-danger" type="submit">Deactivate community</button></form><% } %></div>
</section>

<% if (community.isActive === false && community.adminDeactivationReason) { %><div class="alert alert-error community-audit"><strong>Deactivation reason</strong> · <%= community.adminDeactivationReason %><small>Recorded <%= community.adminDeactivatedAt ? new Date(community.adminDeactivatedAt).toLocaleString("en-NG") : "" %><% if (community.adminDeactivatedBy) { %> by <%= community.adminDeactivatedBy.firstName %> <%= community.adminDeactivatedBy.lastName %><% } %></small></div><% } %>

<section class="stats-grid stats-grid-compact"><article class="stat-card"><span>All members</span><strong><%= memberCount.toLocaleString("en-NG") %></strong><small><%= memberStats.active || 0 %> active</small></article><article class="stat-card"><span>Paid memberships</span><strong><%= orderCount.toLocaleString("en-NG") %></strong><small>Successful orders</small></article><article class="stat-card"><span>Posts and messages</span><strong><%= content.length === 8 ? "8+" : content.length %></strong><small>Recent activity below</small></article><article class="stat-card"><span>Member access</span><strong class="metric-word"><%= community.membershipType %></strong><small><%= community.joinPolicy.replaceAll("_", " ") %> joining</small></article></section>

<div class="detail-grid">
  <section class="panel"><div class="panel-heading"><div><p class="eyebrow">Membership</p><h2>Community members</h2><p>Recent membership records and current access state.</p></div></div><div class="table-wrap"><table><thead><tr><th>Member</th><th>Role</th><th>Status</th><th>Joined</th></tr></thead><tbody><% members.forEach((member) => { const user = member.userId || {}; %><tr><td><strong><%= user.firstName || "Unavailable" %> <%= user.lastName || "" %></strong><small><%= user.status || "" %></small></td><td><span class="role-tag"><%= member.role %></span></td><td><span class="status status-<%= member.status %>"><%= member.status %></span></td><td><%= member.joinedAt ? new Date(member.joinedAt).toLocaleDateString("en-NG") : "—" %></td></tr><% }) %><% if (!members.length) { %><tr><td colspan="4" class="empty">No member records.</td></tr><% } %></tbody></table></div><div class="pagination"><span>Page <%= page %> of <%= pageCount %></span><div><% if (page > 1) { %><a class="button button-soft button-small" href="?page=<%= page - 1 %>">Previous</a><% } %><% if (page < pageCount) { %><a class="button button-soft button-small" href="?page=<%= page + 1 %>">Next</a><% } %></div></div></section>
  <section class="panel"><div class="panel-heading"><div><p class="eyebrow">Membership sales</p><h2>Recent orders</h2><p>Successful and refunded premium memberships.</p></div></div><div class="order-list"><% orders.forEach((order) => { const buyer = order.buyerId || {}; %><article class="order-item"><div><strong><%= order.orderNumber %></strong><small><%= buyer.firstName || "Unavailable" %> <%= buyer.lastName || "" %> · <%= buyer.email || "" %></small></div><div class="order-value"><strong>₦<%= (order.grossAmountKobo / 100).toLocaleString("en-NG", { minimumFractionDigits: 2 }) %></strong><small><span class="status status-<%= order.status %>"><%= order.status %></span> · fee ₦<%= (order.platformFeeKobo / 100).toLocaleString("en-NG", { minimumFractionDigits: 2 }) %></small></div></article><% }) %><% if (!orders.length) { %><p class="empty">No paid memberships yet.</p><% } %></div></section>
</div>

<section class="panel"><div class="panel-heading"><div><p class="eyebrow">Community activity</p><h2>Recent posts and messages</h2></div></div><div class="activity-list"><% content.forEach((item) => { const author = item.authorId || {}; %><article class="activity-item"><div class="activity-topline"><span class="role-tag"><%= item.kind %></span><span><%= new Date(item.createdAt).toLocaleString("en-NG") %></span><% if (item.deletedAt) { %><span class="status status-deactivated">removed</span><% } %></div><p><%= item.text || "Shared an attachment" %></p><small>By <%= author.firstName || "Unknown" %> <%= author.lastName || "" %></small></article><% }) %><% if (!content.length) { %><p class="empty">No community content yet.</p><% } %></div></section>
<%- include("partials/shell-bottom") %>
