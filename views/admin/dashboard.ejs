<% const currentTab = typeof activeTab === "undefined" ? "overview" : activeTab || "overview"; %>
<% const pageTab = typeof tabDetails === "undefined" || !tabDetails ? { label: "Community Connect", heading: "Operations overview", subtitle: "Platform activity and the work that needs attention." } : tabDetails; %>
<%- include("partials/shell-top", {
  title,
  csrfToken,
  permissions,
  activeTab: currentTab,
  sectionLabel: pageTab.label,
  heading: pageTab.heading,
  subtitle: pageTab.subtitle,
  message,
}) %>

<% if (currentTab === "overview") { %>
  <section class="stats-grid" aria-label="Platform summary">
    <article class="stat-card"><span>Total members</span><strong><%= stats.userCount.toLocaleString("en-NG") %></strong><small>Community Connect accounts</small></article>
    <article class="stat-card"><span>Member restrictions</span><strong><%= stats.suspendedUserCount.toLocaleString("en-NG") %></strong><small>Accounts currently blocked</small></article>
    <article class="stat-card"><span>Events to review</span><strong><%= stats.pendingEventCount.toLocaleString("en-NG") %></strong><small><%= stats.publishedEventCount.toLocaleString("en-NG") %> published events</small></article>
    <article class="stat-card stat-accent"><span>Platform earnings</span><strong><%= formatNaira(stats.totalEarningsKobo) %></strong><small>Verified completed fees</small></article>
  </section>
  <section class="welcome-panel">
    <div><p class="eyebrow eyebrow-light">Your operations at a glance</p><h2>Keep the community moving.</h2><p>Open a workspace to review activity, support members, and manage the events and communities they care about.</p></div>
    <div class="quick-links">
      <% if (permissions.includes("events:moderate")) { %><a class="button button-light" href="/admin/events">Review events <span>↗</span></a><% } %>
      <% if (permissions.includes("communities:moderate")) { %><a class="button button-light" href="/admin/communities">Explore communities <span>↗</span></a><% } %>
      <% if (permissions.includes("reports:moderate")) { %><a class="button button-light" href="/admin/reports">Open report queue <span>↗</span></a><% } %>
    </div>
  </section>
<% } %>

<section class="section-view <%= currentTab === 'moderation' ? 'is-current' : '' %>" <%= currentTab === 'moderation' ? '' : 'hidden' %>>
  <div class="panel">
    <div class="panel-heading"><div><p class="eyebrow">Event workspace</p><h2>Event listings</h2><p>Review details, ticket sales, and moderation history for each event.</p></div><span class="count-pill"><%= stats.pendingEventCount %> awaiting review</span></div>
    <div class="table-wrap"><table><thead><tr><th>Event</th><th>Host</th><th>Schedule</th><th>Status</th><th>Review</th></tr></thead><tbody>
      <% events.forEach((event) => { const creator = event.creatorId || {}; %>
        <tr><td><strong><%= event.title %></strong><small><%= event.state %>, <%= event.lga %></small></td><td><%= creator.firstName || "Unknown" %> <%= creator.lastName || "" %><small><%= creator.email || "" %></small></td><td><%= new Date(event.startsAt).toLocaleString("en-NG") %></td><td><span class="status status-<%= event.status %>"><%= event.status.replaceAll("_", " ") %></span></td><td class="action-cell"><a class="button button-soft button-small" href="/admin/events/<%= event._id %>">Full details</a>
          <% if (event.status === "pending_approval") { %><form method="post" action="/admin/events/<%= event._id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary button-small" type="submit">Approve</button></form><% } %>
        </td></tr>
      <% }) %>
      <% if (!events.length) { %><tr><td colspan="5" class="empty">No events found.</td></tr><% } %>
    </tbody></table></div>
  </div>
</section>

<section class="section-view <%= currentTab === 'members' ? 'is-current' : '' %>" <%= currentTab === 'members' ? '' : 'hidden' %>>
  <div class="panel"><div class="panel-heading"><div><p class="eyebrow">Member care</p><h2>Member accounts</h2><p>Blocking revokes active refresh sessions. Administrator accounts are protected.</p></div><span class="count-pill"><%= users.length %> recent accounts</span></div>
    <div class="table-wrap"><table><thead><tr><th>Member</th><th>Role</th><th>Status</th><th>Joined</th><th>Account control</th></tr></thead><tbody>
      <% users.forEach((user) => { %><tr><td><strong><%= user.firstName %> <%= user.lastName %></strong><small><%= user.email %></small></td><td><span class="role-tag"><%= user.role %></span></td><td><span class="status status-<%= user.status %>"><%= user.status.replaceAll("_", " ") %></span></td><td><%= new Date(user.createdAt).toLocaleDateString("en-NG") %></td><td>
        <% if (permissions.includes("users:moderate") && user.role !== "admin" && user.status === "active") { %><form method="post" action="/admin/users/<%= user._id %>/block" onsubmit="return confirm('Block this member and revoke active sessions?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger button-small" type="submit">Block member</button></form>
        <% } else if (permissions.includes("users:moderate") && user.role !== "admin" && user.status === "suspended") { %><form method="post" action="/admin/users/<%= user._id %>/unblock" onsubmit="return confirm('Restore this member account?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary button-small" type="submit">Restore member</button></form>
        <% } else if (user.role === "admin") { %><span class="muted">Protected administrator account</span><% } else { %><span class="muted">No action available</span><% } %>
      </td></tr><% }) %>
      <% if (!users.length) { %><tr><td colspan="5" class="empty">No user accounts found.</td></tr><% } %>
    </tbody></table></div>
  </div>
</section>

<section class="section-view <%= currentTab === 'administrators' ? 'is-current' : '' %>" <%= currentTab === 'administrators' ? '' : 'hidden' %>>
  <div class="dual-section">
    <article class="panel"><div class="panel-heading compact-heading"><div><p class="eyebrow">Team access</p><h2>Add administrator</h2><p>New administrators receive active, verified portal access.</p></div></div>
      <% if (permissions.includes("admins:manage")) { %><form method="post" action="/admin/admins" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>First name<input name="firstName" required minlength="2" maxlength="60" autocomplete="given-name"></label><label>Last name<input name="lastName" required minlength="2" maxlength="60" autocomplete="family-name"></label><label class="full-width">Email address<input type="email" name="email" required maxlength="254" autocomplete="email"></label><label class="full-width">Temporary password<input type="password" name="password" required minlength="12" maxlength="128" autocomplete="new-password"></label><p class="form-hint full-width">Use uppercase and lowercase letters, a number, and a symbol.</p><button class="button button-primary full-width" type="submit">Create administrator</button></form><% } else { %><p class="empty">You do not have permission to manage administrators.</p><% } %>
    </article>
    <article class="panel"><div class="panel-heading compact-heading"><div><p class="eyebrow">Access directory</p><h2>Administrator team</h2></div><span class="count-pill"><%= admins.length %> records</span></div><div class="directory-list">
      <% admins.forEach((admin) => { const account = admin.userId || {}; %><div class="directory-item"><span class="avatar"><%= (account.firstName || "A").charAt(0) %><%= (account.lastName || "").charAt(0) %></span><div><strong><%= account.firstName || "Unknown" %> <%= account.lastName || "" %></strong><small><%= account.email || "Account unavailable" %></small></div><span class="status status-<%= admin.active ? 'active' : 'suspended' %>"><%= admin.active ? "active" : "inactive" %></span></div><% }) %>
      <% if (!admins.length) { %><p class="empty">No administrator records found.</p><% } %>
    </div></article>
  </div>
</section>

<section class="section-view <%= currentTab === 'finance' ? 'is-current' : '' %>" <%= currentTab === 'finance' ? '' : 'hidden' %>>
  <div class="panel"><div class="panel-heading"><div><p class="eyebrow">Revenue desk</p><h2>Charge earnings</h2><p>Fees recognized through completed platform transactions.</p></div></div>
    <div class="breakdown-grid"><% earningBreakdown.forEach((item) => { %><article class="mini-card"><span><%= item._id.replaceAll("_", " ") %></span><strong><%= formatNaira(item.totalKobo) %></strong><small><%= item.count %> charges</small></article><% }) %><% if (!earningBreakdown.length) { %><p class="empty">No completed charges yet.</p><% } %></div>
    <div class="table-wrap"><table><thead><tr><th>Source</th><th>Gross</th><th>Platform fee</th><th>Net / proceeds</th><th>Earned</th></tr></thead><tbody><% recentEarnings.forEach((earning) => { %><tr><td><strong><%= earning.sourceType.replaceAll("_", " ") %></strong><small><%= earning.sourceReference %></small></td><td><%= formatNaira(earning.grossAmountKobo) %></td><td class="money-positive"><%= formatNaira(earning.feeAmountKobo) %></td><td><%= formatNaira(earning.netAmountKobo) %></td><td><%= new Date(earning.earnedAt).toLocaleString("en-NG") %></td></tr><% }) %><% if (!recentEarnings.length) { %><tr><td colspan="5" class="empty">No earnings recorded.</td></tr><% } %></tbody></table></div>
  </div>
</section>

<%- include("partials/shell-bottom") %>
