<%- include("partials/shell-top", {
  title,
  csrfToken,
  permissions,
  activeTab,
  sectionLabel: "Trust and support",
  heading: "Reports and app issues",
  subtitle: "Review member reports about app content and support disputes submitted from the app.",
  message,
}) %>

<section class="stats-grid stats-grid-compact" aria-label="Moderation and support totals">
  <article class="stat-card"><span>Open content reports</span><strong><%= reportCounts.open || 0 %></strong><small>Events, people, communities, and messages</small></article>
  <article class="stat-card"><span>Open app issues</span><strong><%= disputeCounts.open || 0 %></strong><small>Payments, tickets, transfers, and more</small></article>
  <article class="stat-card"><span>Being reviewed</span><strong><%= (reportCounts.reviewing || 0) + (disputeCounts.under_review || 0) %></strong><small>Content reports and app issue disputes</small></article>
  <article class="stat-card stat-accent"><span>Awaiting a member</span><strong><%= disputeCounts.awaiting_user || 0 %></strong><small>Support cases with a reply sent</small></article>
</section>

<section class="panel" aria-labelledby="content-reports-heading">
  <div class="panel-heading panel-heading-filter">
    <div><p class="eyebrow">Member submitted reports</p><h2 id="content-reports-heading">App content reports</h2><p>Reports submitted against events, communities, members, and community messages.</p></div>
    <form method="get" action="/admin/reports" class="filter-form">
      <input type="hidden" name="disputeStatus" value="<%= disputeStatus %>"><input type="hidden" name="disputePage" value="<%= disputePage %>">
      <label>Report status<select name="reportStatus"><% ["all", "open", "reviewing", "resolved", "dismissed"].forEach((value) => { %><option value="<%= value %>" <%= reportStatus === value ? "selected" : "" %>><%= value === "all" ? "All statuses" : value.replaceAll("_", " ") %></option><% }) %></select></label>
      <label>Reported item<select name="reportTargetType"><% [["all", "All types"], ["event", "Events"], ["community", "Communities"], ["user", "Members"], ["community_message", "Community messages"]].forEach(([value, label]) => { %><option value="<%= value %>" <%= reportTargetType === value ? "selected" : "" %>><%= label %></option><% }) %></select></label>
      <button class="button button-primary" type="submit">Apply filters</button>
    </form>
  </div>
  <div class="report-list">
    <% reports.forEach((report) => { const target = report.target || {}; const reporter = report.reporterId || {}; const targetCommunity = report.targetType === "community_message" ? target.communityId || {} : null; const contentAuthor = report.targetType === "community_message" ? target.authorId || {} : null; %>
      <article class="report-card">
        <div class="report-head"><div><span class="status status-<%= report.status %>"><%= report.status.replaceAll("_", " ") %></span><span class="role-tag"><%= report.targetType.replaceAll("_", " ") %></span><span class="role-tag"><%= report.reason.replaceAll("_", " ") %></span></div><time><%= new Date(report.createdAt).toLocaleString("en-NG") %></time></div>
        <div class="report-columns">
          <div><p class="eyebrow">Reporter</p><strong><%= reporter.firstName || "Account unavailable" %> <%= reporter.lastName || "" %></strong><small>Reporter ID · <%= report.reporterId?._id || report.reporterId %></small></div>
          <div><p class="eyebrow">Reported item</p>
            <% if (report.targetType === "event") { %><strong><%= target.title || "Event no longer available" %></strong><small><%= target.status || "" %> · <%= target.state || "" %><%= target.lga ? ", " + target.lga : "" %></small><% if (target._id) { %><a class="text-link" href="/admin/events/<%= target._id %>">Open event and ticket details ↗</a><% } %>
            <% } else if (report.targetType === "community") { %><strong><%= target.name || "Community no longer available" %></strong><small><%= target.visibility || "" %> · <%= target.isActive === false ? "deactivated" : "active" %></small><% if (target._id) { %><a class="text-link" href="/admin/communities/<%= target._id %>">Open community controls ↗</a><% } %>
            <% } else if (report.targetType === "user") { %><strong><%= target.firstName || "Account unavailable" %> <%= target.lastName || "" %></strong><small><%= target.email || "" %> · <%= target.role || "member" %> · <%= target.status || "" %></small><a class="text-link" href="/admin?tab=members">Open member workspace ↗</a>
            <% } else { %><strong><%= target.kind || "Community message" %> in <%= targetCommunity.name || "community unavailable" %></strong><% if (target.deletedAt) { %><small>This message was removed by its author or a community moderator.</small><% } %><blockquote><%= target.text || (target.deletedAt ? "This message has been removed." : "No message text was stored.") %></blockquote><% if (target.imageUrl) { %><a class="attachment-link" href="<%= target.imageUrl %>" target="_blank" rel="noopener noreferrer">View message image ↗</a><% } %><% (target.attachments || []).forEach((attachment) => { %><a class="attachment-link" href="<%= attachment.url %>" target="_blank" rel="noopener noreferrer"><%= attachment.name %> · <%= attachment.type %> ↗</a><% }) %><small>Posted by <%= contentAuthor.firstName || "Unknown" %> <%= contentAuthor.lastName || "" %><% if (target.communityId?._id) { %> · <a class="text-link" href="/admin/communities/<%= target.communityId._id %>">View community ↗</a><% } %></small><% } %>
          </div>
        </div>
        <% if (report.details) { %><div class="report-details"><p class="eyebrow">Member's explanation</p><p><%= report.details %></p></div><% } %>
        <% if (["resolved", "dismissed"].includes(report.status)) { %><div class="resolution-record"><strong><%= report.status === "resolved" ? "Action taken" : "Report dismissed" %></strong><p><%= report.resolution || "No resolution note recorded." %></p><small><%= report.reviewedAt ? new Date(report.reviewedAt).toLocaleString("en-NG") : "" %></small></div>
        <% } else { %><form method="post" action="/admin/reports/<%= report._id %>/status" class="report-action-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Review note<textarea name="resolution" maxlength="2000" placeholder="Record your review or explain the decision"></textarea></label><div class="report-actions"><button class="button button-soft" name="status" value="reviewing" type="submit">Keep in review</button><button class="button button-primary" name="status" value="resolved" type="submit">Resolve report</button><button class="button button-danger-outline" name="status" value="dismissed" type="submit">Dismiss report</button></div><small>Resolution and dismissal require a note. Decisions are recorded with the reviewing administrator.</small></form><% } %>
      </article>
    <% }) %>
    <% if (!reports.length) { %><div class="empty-state"><span class="empty-state-mark">✓</span><h3>No content reports in this view</h3><p>Change the filters to review other statuses or report types.</p></div><% } %>
  </div>
  <div class="pagination"><span>Page <%= reportPage %> of <%= reportPageCount %> · <%= reportTotal.toLocaleString("en-NG") %> reports</span><div><% if (reportPage > 1) { %><a class="button button-soft button-small" href="/admin/reports?reportPage=<%= reportPage - 1 %>&amp;reportStatus=<%= reportStatus %>&amp;reportTargetType=<%= reportTargetType %>&amp;disputeStatus=<%= disputeStatus %>&amp;disputePage=<%= disputePage %>">Previous</a><% } %><% if (reportPage < reportPageCount) { %><a class="button button-soft button-small" href="/admin/reports?reportPage=<%= reportPage + 1 %>&amp;reportStatus=<%= reportStatus %>&amp;reportTargetType=<%= reportTargetType %>&amp;disputeStatus=<%= disputeStatus %>&amp;disputePage=<%= disputePage %>">Next</a><% } %></div></div>
</section>

<section class="panel dispute-inbox" aria-labelledby="app-issues-heading">
  <div class="panel-heading panel-heading-filter">
    <div><p class="eyebrow">Support cases submitted in the app</p><h2 id="app-issues-heading">App issue disputes</h2><p>Payment, withdrawal, transfer, ticket, event, harassment, and other member-submitted issues.</p></div>
    <form method="get" action="/admin/reports" class="filter-form">
      <input type="hidden" name="reportStatus" value="<%= reportStatus %>"><input type="hidden" name="reportTargetType" value="<%= reportTargetType %>"><input type="hidden" name="reportPage" value="<%= reportPage %>">
      <label>Case status<select name="disputeStatus"><% ["all", "open", "under_review", "awaiting_user", "resolved", "closed"].forEach((value) => { %><option value="<%= value %>" <%= disputeStatus === value ? "selected" : "" %>><%= value === "all" ? "All statuses" : value.replaceAll("_", " ") %></option><% }) %></select></label>
      <button class="button button-primary" type="submit">Apply filters</button>
    </form>
  </div>
  <div class="report-list">
    <% disputes.forEach((dispute) => { const member = dispute.userId || {}; const transaction = dispute.transactionId || null; const assignedTo = dispute.assignedTo || {}; %>
      <article class="report-card dispute-card">
        <div class="report-head"><div><span class="status status-<%= dispute.status %>"><%= dispute.status.replaceAll("_", " ") %></span><span class="role-tag"><%= dispute.category %></span><span class="priority-pill priority-<%= dispute.priority %>"><%= dispute.priority %> priority</span><strong class="dispute-number"><%= dispute.disputeNumber %></strong></div><time>Submitted <%= new Date(dispute.createdAt).toLocaleString("en-NG") %></time></div>
        <div class="report-columns dispute-overview">
          <div><p class="eyebrow">Member and issue</p><h3><%= dispute.subject %></h3><p class="dispute-description"><%= dispute.description %></p><small><%= member.firstName || "Account unavailable" %> <%= member.lastName || "" %> · <%= member.email || "" %><% if (member.status) { %> · <%= member.status %><% } %></small></div>
          <div><p class="eyebrow">Related transaction</p><% if (transaction) { %><strong><%= transaction.title %></strong><small><%= transaction.reference %></small><small><%= transaction.type.replaceAll("_", " ") %> · <%= transaction.direction %> · <%= formatNaira(transaction.amountKobo) %> <%= transaction.currency %></small><small>Fee <%= formatNaira(transaction.feeKobo || 0) %> · <span class="status status-<%= transaction.status %>"><%= transaction.status %></span></small><% if (transaction.completedAt) { %><small>Completed <%= new Date(transaction.completedAt).toLocaleString("en-NG") %></small><% } %><% } else { %><strong>No transaction attached</strong><small>This issue was submitted from the app without a linked wallet transaction.</small><% } %><% if (assignedTo.firstName) { %><small>Assigned to <%= assignedTo.firstName %> <%= assignedTo.lastName || "" %></small><% } %></div>
        </div>
        <div class="dispute-thread"><div class="dispute-thread-heading"><div><p class="eyebrow">Conversation</p><h3>Member and support messages</h3></div><span class="count-pill"><%= dispute.messages.length %> messages</span></div>
          <% dispute.messages.forEach((entry) => { const author = entry.authorId || {}; %><article class="dispute-message <%= entry.internal ? 'is-internal' : '' %>"><div class="dispute-message-meta"><strong><%= author.firstName || "Account unavailable" %> <%= author.lastName || "" %></strong><span><%= entry.internal ? "Private admin note" : author.role === "admin" ? "Support reply" : "Member reply" %></span><time><%= new Date(entry.createdAt).toLocaleString("en-NG") %></time></div><p><%= entry.message %></p><% (entry.attachments || []).forEach((attachmentUrl) => { %><a class="attachment-link" href="<%= attachmentUrl %>" target="_blank" rel="noopener noreferrer">Open attachment ↗</a><% }) %></article><% }) %>
          <% if (!dispute.messages.length) { %><p class="muted">No replies yet. Send a response or leave a private note.</p><% } %>
        </div>
        <% if (!["resolved", "closed"].includes(dispute.status)) { %><div class="dispute-admin-actions"><form method="post" action="/admin/disputes/<%= dispute._id %>/messages" class="report-action-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Reply or note<textarea name="message" minlength="1" maxlength="3000" required placeholder="Write a reply for the member or a private note for the support team"></textarea></label><label class="checkbox-label"><input type="checkbox" name="internal" value="true"> Keep this as a private admin note</label><button class="button button-primary" type="submit">Add reply</button></form>
          <form method="post" action="/admin/disputes/<%= dispute._id %>/status" class="report-action-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Case status<select name="status"><% ["open", "under_review", "awaiting_user", "resolved", "closed"].forEach((value) => { %><option value="<%= value %>" <%= dispute.status === value ? "selected" : "" %>><%= value.replaceAll("_", " ") %></option><% }) %></select></label><label>Resolution note<textarea name="resolution" maxlength="3000" placeholder="Required when resolving or closing this issue"><%= dispute.resolution || "" %></textarea></label><button class="button button-soft" type="submit">Save case status</button></form></div>
        <% } else { %><div class="resolution-record"><strong><%= dispute.status === "resolved" ? "Issue resolved" : "Case closed" %></strong><p><%= dispute.resolution || "No resolution note recorded." %></p><small><%= dispute.resolvedAt ? new Date(dispute.resolvedAt).toLocaleString("en-NG") : "" %></small></div><% } %>
      </article>
    <% }) %>
    <% if (!disputes.length) { %><div class="empty-state"><span class="empty-state-mark">✓</span><h3>No app issue disputes in this view</h3><p>Change the case status filter to review other submissions.</p></div><% } %>
  </div>
  <div class="pagination"><span>Page <%= disputePage %> of <%= disputePageCount %> · <%= disputeTotal.toLocaleString("en-NG") %> app issues</span><div><% if (disputePage > 1) { %><a class="button button-soft button-small" href="/admin/reports?disputePage=<%= disputePage - 1 %>&amp;disputeStatus=<%= disputeStatus %>&amp;reportPage=<%= reportPage %>&amp;reportStatus=<%= reportStatus %>&amp;reportTargetType=<%= reportTargetType %>">Previous</a><% } %><% if (disputePage < disputePageCount) { %><a class="button button-soft button-small" href="/admin/reports?disputePage=<%= disputePage + 1 %>&amp;disputeStatus=<%= disputeStatus %>&amp;reportPage=<%= reportPage %>&amp;reportStatus=<%= reportStatus %>&amp;reportTargetType=<%= reportTargetType %>">Next</a><% } %></div></div>
</section>
<%- include("partials/shell-bottom") %>
